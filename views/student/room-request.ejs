<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container py-4 flex-grow-1">
  <%- include('../partials/alerts') %>

  <div class="row justify-content-center">
    <div class="col-lg-7">
      <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
          <h4 class="fw-bold mb-0 text-primary">
            <i class="bi bi-send-check-fill me-2"></i> Apply for Hostel Room
          </h4>
        </div>
        <div class="card-body p-4">
          <form action="/student/room-request" method="POST">
            <!-- Block Selection -->
            <div class="mb-3">
              <label for="blockSelect" class="form-label fw-semibold small">Select Hostel Block <span class="text-danger">*</span></label>
              <select class="form-select" id="blockSelect" name="blockId" required>
                <option value="">-- Choose Hostel Block --</option>
                <% blocks.forEach(block => { %>
                  <option value="<%= block._id %>" <%= (preselectedRoom && preselectedRoom.block && preselectedRoom.block._id.toString() === block._id.toString()) ? 'selected' : '' %>>
                    <%= block.name %> (<%= block.code %>) &mdash; <%= block.genderRestriction %>
                  </option>
                <% }) %>
              </select>
            </div>

            <!-- Room Selection -->
            <div class="mb-3">
              <label for="roomSelect" class="form-label fw-semibold small">Select Available Room <span class="text-danger">*</span></label>
              <select class="form-select" id="roomSelect" name="roomId" required>
                <option value="">-- Choose Room --</option>
                <% availableRooms.forEach(room => { %>
                  <% const avail = Math.max(0, room.capacity - room.currentOccupancy); %>
                  <option 
                    value="<%= room._id %>" 
                    data-block="<%= room.block ? room.block._id : '' %>"
                    <%= (preselectedRoom && preselectedRoom._id.toString() === room._id.toString()) ? 'selected' : '' %>>
                    Room <%= room.roomNumber %> &bull; <%= room.roomType %> (Floor <%= room.floor %>, <%= avail %> bed<%= avail > 1 ? 's' : '' %> free)
                  </option>
                <% }) %>
              </select>
              <div class="form-text">Only rooms with vacant beds and active status are available for selection.</div>
            </div>

            <!-- Student Remarks -->
            <div class="mb-4">
              <label for="remarks" class="form-label fw-semibold small">Special Requests / Remarks (Optional)</label>
              <textarea class="form-control" id="remarks" name="remarks" rows="3" placeholder="e.g. Ground floor preference for medical reasons, roommate preferences..."></textarea>
            </div>

            <div class="d-flex justify-content-between align-items-center">
              <a href="/student/rooms" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Rooms
              </a>
              <button type="submit" class="btn btn-primary px-4 fw-semibold">
                <i class="bi bi-send-fill me-1"></i> Submit Application
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
