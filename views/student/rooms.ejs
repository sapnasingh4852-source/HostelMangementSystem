<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container py-4 flex-grow-1">
  <%- include('../partials/alerts') %>

  <div class="d-flex justify-content-between align-items-center flex-wrap mb-4 pb-2 border-bottom">
    <div>
      <h2 class="fw-bold mb-1">Browse Available Rooms</h2>
      <p class="text-muted mb-0">Explore hostel blocks, view amenities, and apply for your preferred room.</p>
    </div>
    <div class="mt-2 mt-md-0">
      <% if (!hasActiveAllotment && !hasPendingRequest) { %>
        <a href="/student/room-request" class="btn btn-primary">
          <i class="bi bi-send-check me-1"></i> Submit Room Request
        </a>
      <% } %>
    </div>
  </div>

  <!-- Filters Card -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
      <form action="/student/rooms" method="GET" class="row g-2 align-items-end">
        <div class="col-md-3">
          <label class="form-label fw-semibold small">Hostel Block</label>
          <select name="block" class="form-select form-select-sm">
            <option value="">All Blocks</option>
            <% blocks.forEach(b => { %>
              <option value="<%= b._id %>" <%= query.block == b._id.toString() ? 'selected' : '' %>>
                <%= b.name %> (<%= b.genderRestriction %>)
              </option>
            <% }) %>
          </select>
        </div>

        <div class="col-md-3">
          <label class="form-label fw-semibold small">Room Type</label>
          <select name="roomType" class="form-select form-select-sm">
            <option value="">All Types</option>
            <option value="Single" <%= query.roomType === 'Single' ? 'selected' : '' %>>Single Bed</option>
            <option value="Double" <%= query.roomType === 'Double' ? 'selected' : '' %>>Double Sharing</option>
            <option value="Triple" <%= query.roomType === 'Triple' ? 'selected' : '' %>>Triple Sharing</option>
            <option value="Dormitory" <%= query.roomType === 'Dormitory' ? 'selected' : '' %>>Dormitory</option>
          </select>
        </div>

        <div class="col-md-2">
          <label class="form-label fw-semibold small">Floor</label>
          <input type="number" name="floor" class="form-control form-control-sm" placeholder="Any" value="<%= query.floor || '' %>" min="0">
        </div>

        <div class="col-md-2">
          <label class="form-label fw-semibold small">Facility</label>
          <select name="facility" class="form-select form-select-sm">
            <option value="">Any Facility</option>
            <option value="Attached Bathroom" <%= query.facility === 'Attached Bathroom' ? 'selected' : '' %>>Attached Bathroom</option>
            <option value="AC" <%= query.facility === 'AC' ? 'selected' : '' %>>AC</option>
            <option value="Wi-Fi" <%= query.facility === 'Wi-Fi' ? 'selected' : '' %>>Wi-Fi</option>
            <option value="Balcony" <%= query.facility === 'Balcony' ? 'selected' : '' %>>Balcony</option>
          </select>
        </div>

        <div class="col-md-2 d-flex gap-2">
          <button type="submit" class="btn btn-primary btn-sm w-100 fw-semibold">
            <i class="bi bi-funnel-fill me-1"></i> Filter
          </button>
          <a href="/student/rooms" class="btn btn-outline-secondary btn-sm" title="Reset Filters">
            <i class="bi bi-arrow-counterclockwise"></i>
          </a>
        </div>
      </form>
    </div>
  </div>

  <!-- Rooms Cards Grid -->
  <div class="row g-4">
    <% if (rooms && rooms.length > 0) { %>
      <% rooms.forEach(room => { %>
        <% const available = Math.max(0, room.capacity - room.currentOccupancy); %>
        <% const isFull = available === 0 || room.status === 'Full'; %>
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 card-hover shadow-sm border-0 <%= isFull ? 'opacity-75' : '' %>">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
              <div>
                <span class="badge bg-dark-subtle text-dark me-1"><%= room.block ? room.block.name : 'Block' %></span>
                <span class="fw-bold fs-5 text-primary">Room <%= room.roomNumber %></span>
              </div>
              <span class="badge <%= isFull ? 'bg-danger' : 'bg-success' %>">
                <%= isFull ? 'Full' : `${available} Bed${available > 1 ? 's' : ''} Left` %>
              </span>
            </div>
            <div class="card-body">
              <div class="d-flex justify-content-between mb-2 small text-muted">
                <span><i class="bi bi-layers me-1"></i> Floor <%= room.floor %></span>
                <span><i class="bi bi-people me-1"></i> <%= room.roomType %></span>
              </div>

              <!-- Occupancy Progress Bar -->
              <div class="mb-3">
                <div class="d-flex justify-content-between small mb-1">
                  <span>Occupancy:</span>
                  <span class="fw-semibold"><%= room.currentOccupancy %> / <%= room.capacity %> Beds</span>
                </div>
                <div class="progress" style="height: 6px;">
                  <div class="progress-bar <%= isFull ? 'bg-danger' : 'bg-primary' %>" role="progressbar" style="width: <%= (room.currentOccupancy / room.capacity) * 100 %>%;"></div>
                </div>
              </div>

              <!-- Monthly Fee -->
              <% if (room.monthlyFee > 0) { %>
                <div class="mb-3">
                  <span class="small text-muted">Monthly Rent: </span>
                  <span class="fw-bold text-success"><%= helpers.formatCurrency(room.monthlyFee) %></span>
                </div>
              <% } %>

              <!-- Facilities list -->
              <div class="mb-3">
                <div class="small fw-semibold text-secondary mb-1">Amenities:</div>
                <div>
                  <% if (room.facilities && room.facilities.length > 0) { %>
                    <% room.facilities.forEach(f => { %>
                      <span class="facility-badge"><i class="bi bi-check2"></i> <%= f %></span>
                    <% }) %>
                  <% } else { %>
                    <span class="text-muted small">Standard amenities</span>
                  <% } %>
                </div>
              </div>
            </div>

            <div class="card-footer bg-white border-0 pt-0 pb-3">
              <% if (hasActiveAllotment) { %>
                <button class="btn btn-light btn-sm w-100 text-muted" disabled>
                  <i class="bi bi-check2-all me-1"></i> Already Allotted to a Room
                </button>
              <% } else if (hasPendingRequest) { %>
                <button class="btn btn-warning-subtle text-warning-emphasis btn-sm w-100" disabled>
                  <i class="bi bi-clock me-1"></i> Request Already Pending
                </button>
              <% } else if (isFull) { %>
                <button class="btn btn-danger-subtle text-danger btn-sm w-100" disabled>
                  <i class="bi bi-x-circle me-1"></i> Room is Currently Full
                </button>
              <% } else if (room.status === 'Maintenance') { %>
                <button class="btn btn-info-subtle text-info-emphasis btn-sm w-100" disabled>
                  <i class="bi bi-tools me-1"></i> Under Maintenance
                </button>
              <% } else { %>
                <a href="/student/room-request?roomId=<%= room._id %>" class="btn btn-primary btn-sm w-100 fw-semibold">
                  <i class="bi bi-box-arrow-in-right me-1"></i> Request This Room
                </a>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="col-12">
        <div class="card p-5 text-center border-0 shadow-sm text-muted">
          <i class="bi bi-door-closed fs-1 mb-2 text-secondary"></i>
          <h4>No Rooms Found</h4>
          <p class="small mb-3">No rooms match your chosen filter criteria. Try adjusting the filters.</p>
          <div><a href="/student/rooms" class="btn btn-outline-primary btn-sm">Clear All Filters</a></div>
        </div>
      </div>
    <% } %>
  </div>
</main>

<%- include('../partials/footer') %>
