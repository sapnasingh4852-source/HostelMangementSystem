<%- include('../../partials/header') %>
<%- include('../../partials/navbar') %>

<main class="container-fluid px-lg-4 py-4 flex-grow-1">
  <%- include('../../partials/alerts') %>

  <div class="d-flex justify-content-between align-items-center flex-wrap mb-4 pb-2 border-bottom">
    <div>
      <h2 class="fw-bold mb-1">Hostel Blocks Management</h2>
      <p class="text-muted mb-0">Configure dormitory buildings, floor counts, and gender residency policies.</p>
    </div>
    <div class="mt-2 mt-md-0">
      <a href="/admin/blocks/new" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Add New Block
      </a>
    </div>
  </div>

  <div class="row g-4">
    <% if (blocks && blocks.length > 0) { %>
      <% blocks.forEach(block => { %>
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 shadow-sm border-0 card-hover">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
              <div>
                <h5 class="fw-bold text-dark mb-0"><%= block.name %></h5>
                <code class="small text-muted"><%= block.code %></code>
              </div>
              <span class="badge <%= helpers.statusBadge(block.status) %>"><%= block.status %></span>
            </div>
            <div class="card-body">
              <p class="text-secondary small mb-3"><%= block.description || 'No specific description provided.' %></p>

              <div class="row g-2 text-center mb-3">
                <div class="col-4">
                  <div class="p-2 bg-light rounded">
                    <div class="text-muted small">Floors</div>
                    <div class="fw-bold text-dark"><%= block.numberOfFloors %></div>
                  </div>
                </div>
                <div class="col-4">
                  <div class="p-2 bg-light rounded">
                    <div class="text-muted small">Rooms</div>
                    <div class="fw-bold text-primary"><%= block.roomCount %></div>
                  </div>
                </div>
                <div class="col-4">
                  <div class="p-2 bg-light rounded">
                    <div class="text-muted small">Beds</div>
                    <div class="fw-bold text-success"><%= block.totalCapacity %></div>
                  </div>
                </div>
              </div>

              <div class="d-flex justify-content-between align-items-center small text-muted mb-2">
                <span>Residency: <span class="badge bg-light text-dark border"><%= block.genderRestriction %></span></span>
                <span>Available: <strong class="text-primary"><%= block.availableBeds %> beds</strong></span>
              </div>

              <!-- Progress -->
              <% const pct = block.totalCapacity > 0 ? Math.round((block.totalOccupancy / block.totalCapacity) * 100) : 0; %>
              <div class="progress" style="height: 6px;">
                <div class="progress-bar <%= pct >= 90 ? 'bg-danger' : 'bg-primary' %>" style="width: <%= pct %>%;"></div>
              </div>
            </div>

            <div class="card-footer bg-white border-0 pt-0 pb-3 d-flex justify-content-end gap-2">
              <a href="/admin/rooms?block=<%= block._id %>" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-door-open me-1"></i> Rooms
              </a>
              <a href="/admin/blocks/<%= block._id %>/edit" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-pencil-square me-1"></i> Edit
              </a>
              <form action="/admin/blocks/<%= block._id %>/delete" method="POST" class="d-inline" data-confirm="Are you sure you want to delete this block? This cannot be undone.">
                <button type="submit" class="btn btn-sm btn-outline-danger">
                  <i class="bi bi-trash"></i>
                </button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="col-12">
        <div class="card p-5 text-center shadow-sm border-0 text-muted">
          <i class="bi bi-building fs-1 mb-2 text-secondary"></i>
          <h4>No Hostel Blocks Created</h4>
          <p class="small text-muted mb-3">Add hostel blocks (e.g. Block A, Block B) before creating rooms.</p>
          <div>
            <a href="/admin/blocks/new" class="btn btn-primary btn-sm">Add First Block</a>
          </div>
        </div>
      </div>
    <% } %>
  </div>
</main>

<%- include('../../partials/footer') %>
