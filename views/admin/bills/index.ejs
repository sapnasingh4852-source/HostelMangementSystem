<%- include('../../partials/header') %>
<%- include('../../partials/navbar') %>

<main class="container-fluid px-lg-4 py-4 flex-grow-1">
  <%- include('../../partials/alerts') %>

  <div class="d-flex justify-content-between align-items-center flex-wrap mb-4 pb-2 border-bottom">
    <div>
      <h2 class="fw-bold mb-1">Mess Billing Management</h2>
      <p class="text-muted mb-0">Review student monthly catering statements, attendance-based charges, and settle payments.</p>
    </div>
    <div class="mt-2 mt-md-0">
      <a href="/admin/bills/generate" class="btn btn-primary">
        <i class="bi bi-calculator me-1"></i> Generate Monthly Bills
      </a>
    </div>
  </div>

  <!-- Filter Card -->
  <div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
      <form action="/admin/bills" method="GET" class="row g-2 align-items-end">
        <div class="col-md-3">
          <label class="form-label fw-semibold small">Month</label>
          <select name="month" class="form-select form-select-sm">
            <option value="">All Months</option>
            <% for (let m = 1; m <= 12; m++) { %>
              <option value="<%= m %>" <%= query.month == m ? 'selected' : '' %>><%= helpers.monthName(m) %></option>
            <% } %>
          </select>
        </div>

        <div class="col-md-2">
          <label class="form-label fw-semibold small">Year</label>
          <input type="number" name="year" class="form-control form-control-sm" placeholder="e.g. 2026" value="<%= query.year || '' %>">
        </div>

        <div class="col-md-3">
          <label class="form-label fw-semibold small">Payment Status</label>
          <select name="status" class="form-select form-select-sm">
            <option value="">All Statuses</option>
            <option value="Unpaid" <%= query.status === 'Unpaid' ? 'selected' : '' %>>Unpaid</option>
            <option value="Paid" <%= query.status === 'Paid' ? 'selected' : '' %>>Paid</option>
            <option value="Waived" <%= query.status === 'Waived' ? 'selected' : '' %>>Waived</option>
          </select>
        </div>

        <div class="col-md-2 d-flex gap-2">
          <button type="submit" class="btn btn-primary btn-sm w-100 fw-semibold">Filter</button>
          <a href="/admin/bills" class="btn btn-outline-secondary btn-sm">Reset</a>
        </div>
      </form>
    </div>
  </div>

  <!-- Bills Table -->
  <div class="card shadow-sm border-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead>
          <tr>
            <th>Billing Period</th>
            <th>Student Name</th>
            <th>Roll No / ID</th>
            <th>Department</th>
            <th>Days Present</th>
            <th>Rate / Day</th>
            <th>Total Amount</th>
            <th>Status</th>
            <th class="text-end">Payment Settlement</th>
          </tr>
        </thead>
        <tbody>
          <% if (bills && bills.length > 0) { %>
            <% bills.forEach(bill => { %>
              <tr>
                <td class="fw-bold text-dark">
                  <%= helpers.monthName(bill.month) %> <%= bill.year %>
                </td>
                <td><%= bill.student ? bill.student.name : 'Unknown' %></td>
                <td><code><%= bill.student ? bill.student.studentId : 'N/A' %></code></td>
                <td><%= bill.student ? bill.student.department : '-' %></td>
                <td><%= bill.presentDays %> Days</td>
                <td><%= helpers.formatCurrency(bill.ratePerDay) %></td>
                <td class="fw-bold text-primary"><%= helpers.formatCurrency(bill.totalAmount) %></td>
                <td><span class="badge <%= helpers.statusBadge(bill.status) %>"><%= bill.status %></span></td>
                <td class="text-end">
                  <% if (bill.status === 'Unpaid') { %>
                    <form action="/admin/bills/<%= bill._id %>/status" method="POST" class="d-inline">
                      <input type="hidden" name="status" value="Paid">
                      <input type="hidden" name="notes" value="Payment received by admin cash desk">
                      <button type="submit" class="btn btn-sm btn-success fw-semibold">
                        <i class="bi bi-cash-stack me-1"></i> Mark Paid
                      </button>
                    </form>
                  <% } else { %>
                    <span class="small text-muted"><%= bill.status %></span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="9" class="text-center py-5 text-muted">
                No mess bills found. Click "Generate Monthly Bills" to create statements.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<%- include('../../partials/footer') %>
