<%- include('../../partials/header') %>
<%- include('../../partials/navbar') %>

<main class="container-fluid px-lg-4 py-4 flex-grow-1">
  <%- include('../../partials/alerts') %>

  <div class="d-flex justify-content-between align-items-center flex-wrap mb-4 pb-2 border-bottom">
    <div>
      <h2 class="fw-bold mb-1">Hostel Rooms Management</h2>
      <p class="text-muted mb-0">Manage individual room capacities, pricing, amenities, and maintenance states.</p>
    </div>
    <div class="mt-2 mt-md-0">
      <a href="/admin/rooms/new" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Add New Room
      </a>
    </div>
  </div>

  <!-- Filter Card -->
  <div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
      <form action="/admin/rooms" method="GET" class="row g-2 align-items-end">
        <div class="col-md-3">
          <label class="form-label fw-semibold small">Hostel Block</label>
          <select name="block" class="form-select form-select-sm">
            <option value="">All Blocks</option>
            <% blocks.forEach(b => { %>
              <option value="<%= b._id %>" <%= query.block == b._id.toString() ? 'selected' : '' %>>
                <%= b.name %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="col-md-3">
          <label class="form-label fw-semibold small">Room Type</label>
          <select name="roomType" class="form-select form-select-sm">
            <option value="">All Types</option>
            <option value="Single" <%= query.roomType === 'Single' ? 'selected' : '' %>>Single Bed</option>
            <option value="Double" <%= query.roomType === 'Double' ? 'selected' : '' %>>Double Sharing</option>
            <option value="Triple" <%= query.roomType === 'Triple' ? 'selected' : '' %>>Triple Sharing</option>
            <option value="Dormitory" <%= query.roomType === 'Dormitory' ? 'selected' : '' %>>Dormitory</option>
          </select>
        </div>

        <div class="col-md-2">
          <label class="form-label fw-semibold small">Status</label>
          <select name="status" class="form-select form-select-sm">
            <option value="">All Statuses</option>
            <option value="Available" <%= query.status === 'Available' ? 'selected' : '' %>>Available</option>
            <option value="Full" <%= query.status === 'Full' ? 'selected' : '' %>>Full</option>
            <option value="Maintenance" <%= query.status === 'Maintenance' ? 'selected' : '' %>>Maintenance</option>
            <option value="Inactive" <%= query.status === 'Inactive' ? 'selected' : '' %>>Inactive</option>
          </select>
        </div>

        <div class="col-md-2">
          <label class="form-label fw-semibold small">Floor</label>
          <input type="number" name="floor" class="form-control form-control-sm" placeholder="Any" value="<%= query.floor || '' %>" min="0">
        </div>

        <div class="col-md-2 d-flex gap-2">
          <button type="submit" class="btn btn-primary btn-sm w-100 fw-semibold">Filter</button>
          <a href="/admin/rooms" class="btn btn-outline-secondary btn-sm">Reset</a>
        </div>
      </form>
    </div>
  </div>

  <!-- Rooms Table -->
  <div class="card shadow-sm border-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead>
          <tr>
            <th>Block</th>
            <th>Room Number</th>
            <th>Floor</th>
            <th>Type</th>
            <th>Capacity</th>
            <th>Occupied</th>
            <th>Available Beds</th>
            <th>Monthly Rent</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (rooms && rooms.length > 0) { %>
            <% rooms.forEach(room => { %>
              <% const avail = Math.max(0, room.capacity - room.currentOccupancy); %>
              <tr>
                <td><span class="badge bg-light text-dark border"><%= room.block ? room.block.name : 'Unknown' %></span></td>
                <td class="fw-bold text-primary">Room <%= room.roomNumber %></td>
                <td>Floor <%= room.floor %></td>
                <td><%= room.roomType %></td>
                <td><%= room.capacity %> beds</td>
                <td class="text-success fw-semibold"><%= room.currentOccupancy %></td>
                <td>
                  <span class="badge <%= avail === 0 ? 'bg-danger' : 'bg-success' %>">
                    <%= avail %> free
                  </span>
                </td>
                <td><%= helpers.formatCurrency(room.monthlyFee) %></td>
                <td><span class="badge <%= helpers.statusBadge(room.status) %>"><%= room.status %></span></td>
                <td class="text-end">
                  <div class="d-inline-flex gap-1">
                    <a href="/admin/rooms/<%= room._id %>/edit" class="btn btn-sm btn-outline-primary" title="Edit Room">
                      <i class="bi bi-pencil-square"></i>
                    </a>
                    <form action="/admin/rooms/<%= room._id %>/delete" method="POST" class="d-inline" data-confirm="Are you sure you want to delete room <%= room.roomNumber %>?">
                      <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Room" <%= room.currentOccupancy > 0 ? 'disabled' : '' %>>
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="10" class="text-center py-5 text-muted">
                No rooms found matching your filter criteria.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<%- include('../../partials/footer') %>
