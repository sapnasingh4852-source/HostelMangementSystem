<%- include('../../partials/header') %>
<%- include('../../partials/navbar') %>

<main class="container-fluid px-lg-4 py-4 flex-grow-1">
  <%- include('../../partials/alerts') %>

  <div class="d-flex justify-content-between align-items-center flex-wrap mb-4 pb-2 border-bottom">
    <div>
      <h2 class="fw-bold mb-1">Room Change Requests</h2>
      <p class="text-muted mb-0">Review student relocation requests. Approving automatically adjusts occupancies between both rooms.</p>
    </div>
  </div>

  <!-- Filter Card -->
  <div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
      <form action="/admin/room-change-requests" method="GET" class="row g-2 align-items-end">
        <div class="col-md-3">
          <label class="form-label fw-semibold small">Status</label>
          <select name="status" class="form-select form-select-sm">
            <option value="">All Statuses</option>
            <option value="Pending" <%= query.status === 'Pending' ? 'selected' : '' %>>Pending Only</option>
            <option value="Approved" <%= query.status === 'Approved' ? 'selected' : '' %>>Approved</option>
            <option value="Rejected" <%= query.status === 'Rejected' ? 'selected' : '' %>>Rejected</option>
          </select>
        </div>

        <div class="col-md-2 d-flex gap-2">
          <button type="submit" class="btn btn-primary btn-sm w-100 fw-semibold">Filter</button>
          <a href="/admin/room-change-requests" class="btn btn-outline-secondary btn-sm">Reset</a>
        </div>
      </form>
    </div>
  </div>

  <!-- Table -->
  <div class="card shadow-sm border-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead>
          <tr>
            <th>Application Date</th>
            <th>Student Details</th>
            <th>Current Room</th>
            <th>Target Room</th>
            <th>Reason</th>
            <th>Status</th>
            <th>Admin Remarks</th>
            <th class="text-end">Decision</th>
          </tr>
        </thead>
        <tbody>
          <% if (requests && requests.length > 0) { %>
            <% requests.forEach(req => { %>
              <tr>
                <td><%= helpers.formatDate(req.createdAt) %></td>
                <td>
                  <div class="fw-bold text-dark"><%= req.student ? req.student.name : 'Unknown' %></div>
                  <div class="small text-muted">Roll: <%= req.student ? req.student.studentId : 'N/A' %></div>
                  <div class="small text-secondary"><%= req.student ? req.student.department : '' %></div>
                </td>
                <td>
                  <span class="badge bg-secondary-subtle text-dark border">
                    <%= req.currentBlock ? req.currentBlock.name : '' %> - Room <%= req.currentRoom ? req.currentRoom.roomNumber : '-' %>
                  </span>
                </td>
                <td>
                  <span class="badge bg-primary-subtle text-primary border border-primary">
                    <%= req.preferredBlock ? req.preferredBlock.name : '' %> - Room <%= req.preferredRoom ? req.preferredRoom.roomNumber : '-' %>
                  </span>
                  <% if (req.preferredRoom) { %>
                    <div class="small text-muted">
                      <%= req.preferredRoom.currentOccupancy %> / <%= req.preferredRoom.capacity %> occupied
                    </div>
                  <% } %>
                </td>
                <td class="small text-muted" style="max-width: 250px;"><%= req.reason %></td>
                <td><span class="badge <%= helpers.statusBadge(req.status) %>"><%= req.status %></span></td>
                <td class="small text-secondary" style="max-width: 200px;">
                  <%= req.adminRemarks || '-' %>
                  <% if (req.reviewedBy) { %>
                    <div class="text-muted" style="font-size: 0.72rem;">By: <%= req.reviewedBy.name %> on <%= helpers.formatDate(req.reviewedAt) %></div>
                  <% } %>
                </td>
                <td class="text-end">
                  <% if (req.status === 'Pending') { %>
                    <div class="d-inline-flex gap-1">
                      <form action="/admin/room-change-requests/<%= req._id %>/approve" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-success fw-semibold" title="Approve Room Change">
                          <i class="bi bi-check-lg me-1"></i> Approve
                        </button>
                      </form>
                      <form action="/admin/room-change-requests/<%= req._id %>/reject" method="POST" class="d-inline" data-confirm="Are you sure you want to reject this room change request?">
                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Reject Change">
                          <i class="bi bi-x-lg"></i> Reject
                        </button>
                      </form>
                    </div>
                  <% } else { %>
                    <span class="text-muted small">Processed</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="8" class="text-center py-5 text-muted">
                No room change requests found.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<%- include('../../partials/footer') %>
