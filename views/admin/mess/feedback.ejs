<%- include('../../partials/header') %>
<%- include('../../partials/navbar') %>

<main class="container-fluid px-lg-4 py-4 flex-grow-1">
  <%- include('../../partials/alerts') %>

  <div class="d-flex justify-content-between align-items-center flex-wrap mb-4 pb-2 border-bottom">
    <div>
      <h2 class="fw-bold mb-1">Mess Meal Feedback Analytics</h2>
      <p class="text-muted mb-0">Student ratings, quality perceptions, and catering performance metrics.</p>
    </div>
    <div class="mt-2 mt-md-0">
      <a href="/admin/mess" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-calendar3 me-1"></i> Weekly Menus
      </a>
    </div>
  </div>

  <!-- Summary Metric Cards -->
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card p-3 shadow-sm border-0 border-start border-4 border-warning">
        <div class="small text-muted fw-semibold">Overall Mess Rating</div>
        <div class="d-flex align-items-baseline gap-2 mt-1">
          <div class="fs-3 fw-bold text-dark"><%= overallAvg %> <span class="fs-6 text-muted">/ 5</span></div>
          <div class="rating-stars small">
            <% const roundedAvg = Math.round(Number(overallAvg) || 0); %>
            <% for (let i = 1; i <= 5; i++) { %>
              <i class="bi <%= i <= roundedAvg ? 'bi-star-fill' : 'bi-star' %> text-warning"></i>
            <% } %>
          </div>
        </div>
        <div class="small text-muted"><%= totalCount %> total student submissions</div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card p-3 shadow-sm border-0 border-start border-4 border-success">
        <div class="small text-muted fw-semibold">Today's Average Rating</div>
        <div class="d-flex align-items-baseline gap-2 mt-1">
          <div class="fs-3 fw-bold text-success"><%= todayAvg %> <span class="fs-6 text-muted">/ 5</span></div>
        </div>
        <div class="small text-muted">Live catering satisfaction</div>
      </div>
    </div>

    <!-- Meal Wise Cards -->
    <% mealStats.forEach(stat => { %>
      <div class="col-sm-6 col-md-3">
        <div class="card p-3 shadow-sm border-0">
          <div class="small text-muted fw-semibold"><%= stat.mealType %></div>
          <div class="d-flex align-items-baseline justify-content-between mt-1">
            <div class="fs-4 fw-bold text-primary"><%= stat.avg %> <span class="fs-6 text-muted">/ 5</span></div>
            <span class="badge bg-light text-muted border"><%= stat.count %> reviews</span>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

  <!-- Student Reviews Table -->
  <div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
      <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-chat-quote-fill text-primary me-2"></i> Recent Student Reviews</h5>
    </div>
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead>
          <tr>
            <th>Date</th>
            <th>Student</th>
            <th>Department</th>
            <th>Meal Type</th>
            <th>Rating</th>
            <th>Student Comments</th>
          </tr>
        </thead>
        <tbody>
          <% if (allFeedback && allFeedback.length > 0) { %>
            <% allFeedback.forEach(f => { %>
              <tr>
                <td><%= helpers.formatDate(f.date) %></td>
                <td>
                  <div class="fw-bold text-dark"><%= f.student ? f.student.name : 'Anonymous' %></div>
                  <div class="small text-muted">Roll: <%= f.student ? f.student.studentId : 'N/A' %></div>
                </td>
                <td><%= f.student ? f.student.department : '-' %></td>
                <td><span class="badge bg-light text-dark border"><%= f.mealType %></span></td>
                <td>
                  <span class="rating-stars text-nowrap">
                    <% for (let i = 1; i <= 5; i++) { %>
                      <i class="bi <%= i <= f.rating ? 'bi-star-fill' : 'bi-star' %> text-warning"></i>
                    <% } %>
                    <strong class="ms-1 text-dark"><%= f.rating %>/5</strong>
                  </span>
                </td>
                <td class="small text-secondary" style="max-width: 350px;"><%= f.comments || '-' %></td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="6" class="text-center py-5 text-muted">
                No student meal feedback submissions found yet.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<%- include('../../partials/footer') %>
