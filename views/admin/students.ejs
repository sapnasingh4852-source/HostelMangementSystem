<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container-fluid px-lg-4 py-4 flex-grow-1">
  <%- include('../partials/alerts') %>

  <div class="d-flex justify-content-between align-items-center flex-wrap mb-4 pb-2 border-bottom">
    <div>
      <h2 class="fw-bold mb-1">Student Directory & Accommodations</h2>
      <p class="text-muted mb-0">List of registered students, current room allotments, and administrative occupancy controls.</p>
    </div>
  </div>

  <!-- Search & Filter Card -->
  <div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
      <form action="/admin/students" method="GET" class="row g-2 align-items-end">
        <div class="col-md-5">
          <label class="form-label fw-semibold small">Search</label>
          <div class="input-group input-group-sm">
            <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
            <input type="text" name="search" class="form-control" placeholder="Search by student name, roll number, email..." value="<%= query.search || '' %>">
          </div>
        </div>

        <div class="col-md-3">
          <label class="form-label fw-semibold small">Department</label>
          <select name="department" class="form-select form-select-sm">
            <option value="">All Departments</option>
            <option value="Computer Science" <%= query.department === 'Computer Science' ? 'selected' : '' %>>Computer Science</option>
            <option value="Information Technology" <%= query.department === 'Information Technology' ? 'selected' : '' %>>Information Technology</option>
            <option value="Electronics & Comm." <%= query.department === 'Electronics & Comm.' ? 'selected' : '' %>>Electronics & Comm.</option>
            <option value="Mechanical Eng." <%= query.department === 'Mechanical Eng.' ? 'selected' : '' %>>Mechanical Eng.</option>
            <option value="Civil Engineering" <%= query.department === 'Civil Engineering' ? 'selected' : '' %>>Civil Engineering</option>
            <option value="Management Studies" <%= query.department === 'Management Studies' ? 'selected' : '' %>>Management Studies</option>
          </select>
        </div>

        <div class="col-md-2">
          <label class="form-label fw-semibold small">Year</label>
          <select name="year" class="form-select form-select-sm">
            <option value="">All Years</option>
            <option value="1st Year" <%= query.year === '1st Year' ? 'selected' : '' %>>1st Year</option>
            <option value="2nd Year" <%= query.year === '2nd Year' ? 'selected' : '' %>>2nd Year</option>
            <option value="3rd Year" <%= query.year === '3rd Year' ? 'selected' : '' %>>3rd Year</option>
            <option value="4th Year" <%= query.year === '4th Year' ? 'selected' : '' %>>4th Year</option>
            <option value="Postgraduate" <%= query.year === 'Postgraduate' ? 'selected' : '' %>>Postgraduate</option>
          </select>
        </div>

        <div class="col-md-2 d-flex gap-2">
          <button type="submit" class="btn btn-primary btn-sm w-100 fw-semibold">Filter</button>
          <a href="/admin/students" class="btn btn-outline-secondary btn-sm" title="Clear Filters">Reset</a>
        </div>
      </form>
    </div>
  </div>

  <!-- Students Table -->
  <div class="card shadow-sm border-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead>
          <tr>
            <th>Student Name</th>
            <th>Roll No / ID</th>
            <th>Department & Year</th>
            <th>Contact</th>
            <th>Gender</th>
            <th>Room Allotment</th>
            <th class="text-end">Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (students && students.length > 0) { %>
            <% students.forEach(s => { %>
              <tr>
                <td>
                  <div class="fw-bold text-dark"><%= s.name %></div>
                  <div class="small text-muted"><%= s.email %></div>
                </td>
                <td><code><%= s.studentId || 'N/A' %></code></td>
                <td>
                  <div><%= s.department %></div>
                  <div class="small text-muted"><%= s.year %></div>
                </td>
                <td><%= s.phone || '-' %></td>
                <td><span class="badge bg-light text-dark border"><%= s.gender %></span></td>
                <td>
                  <% if (s.activeAllotment && s.activeAllotment.room) { %>
                    <span class="badge bg-success-subtle text-success border border-success">
                      <i class="bi bi-door-open-fill me-1"></i>
                      <%= s.activeAllotment.block ? s.activeAllotment.block.name : '' %> - Room <%= s.activeAllotment.room.roomNumber %>
                    </span>
                    <div class="small text-muted">Since <%= helpers.formatDate(s.activeAllotment.startDate) %></div>
                  <% } else { %>
                    <span class="badge bg-secondary-subtle text-secondary">Not Allotted</span>
                  <% } %>
                </td>
                <td class="text-end">
                  <% if (s.activeAllotment) { %>
                    <form action="/admin/students/<%= s._id %>/vacate" method="POST" class="d-inline" data-confirm="Are you sure you want to vacate this student's room? The bed will be freed automatically.">
                      <button type="submit" class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-box-arrow-right me-1"></i> Vacate Room
                      </button>
                    </form>
                  <% } else { %>
                    <span class="text-muted small">&mdash;</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="7" class="text-center py-5 text-muted">No students found matching your criteria.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
