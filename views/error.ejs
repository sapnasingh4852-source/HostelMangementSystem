<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="container py-5 my-auto text-center">
  <div class="stat-icon bg-danger-subtle text-danger mx-auto mb-3" style="width: 80px; height: 80px; font-size: 2.5rem;">
    <i class="bi bi-exclamation-octagon"></i>
  </div>
  <h1 class="display-4 fw-bold text-dark mb-2"><%= typeof statusCode !== 'undefined' ? statusCode : 500 %></h1>
  <h3 class="fw-bold text-secondary mb-3"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Server Error' %></h3>
  <p class="text-muted mx-auto mb-4" style="max-width: 500px;">
    <%= typeof message !== 'undefined' ? message : 'An unexpected error occurred. Please try again later.' %>
  </p>

  <% if (typeof error !== 'undefined' && error.stack) { %>
    <div class="text-start bg-dark text-light p-3 rounded mx-auto mb-4" style="max-width: 800px; max-height: 250px; overflow-y: auto;">
      <pre class="small m-0 text-danger"><code><%= error.stack %></code></pre>
    </div>
  <% } %>

  <div class="d-flex justify-content-center gap-2">
    <a href="/" class="btn btn-primary px-4 fw-semibold">
      <i class="bi bi-house-door me-1"></i> Return Home
    </a>
  </div>
</main>

<%- include('partials/footer') %>
